<script>
/* =========================================================
   5. FUNCTIONS
   ========================================================= */
const CONFIG = {
  duration: 8,
  fixedDt: 0.002,
  laneMin: 0,
  laneMax: 2.2,
  graphMin: 0,
  graphMax: 2.2,
  laneTop: 270,
  laneBottom: 610,
  graphX: 80,
  graphY: 690,
  graphW: 740,
  graphH: 330,
  DEBUG_TEXT_BOX:false,
  DEBUG_IMAGE_FRAME:false,
  DEBUG_LAYOUT_BOX:false
};

const TEXT = {
  idle:'P leaves offset · PI may overshoot · PID adds damping',
  pOffset:'P retains steady-state error',
  piOvershoot:'PI overshoots because integral action accumulates',
  pidDamping:'PID adds damping and reduces overshoot'
};

const IMAGES = {};

const LAYOUT = {
  pLaneX:180,
  piLaneX:450,
  pidLaneX:720
};

function clamp(v,a,b){ return Math.max(a,Math.min(b,v)); }
function fmt(v,n=3){ return Number(v).toFixed(n); }

function makeController(type,color,gains){
  return {
    type,color,
    gains:{...gains},
    y:0,
    v:0,
    integral:0,
    prevError:null,
    u:0,
    hist:[{t:0,y:0}]
  };
}

const controllers = {
  p: makeController('P','#ef6672',{kp:1.4,ki:0,kd:0}),
  pi: makeController('PI','#f3c34f',{kp:1.8,ki:1.2,kd:0}),
  pid: makeController('PID','#91d65d',{kp:2.6,ki:1.0,kd:0.55})
};

let simTime = 0;
let running = true;
let lastFrame = null;

function getPlant(){
  return {
    target:+document.getElementById('target').value,
    wn:+document.getElementById('wn').value,
    zeta:+document.getElementById('zeta').value,
    umax:+document.getElementById('umax').value,
    speed:+document.getElementById('speed').value
  };
}

function syncGains(){
  controllers.p.gains.kp=+document.getElementById('pKp').value;

  controllers.pi.gains.kp=+document.getElementById('piKp').value;
  controllers.pi.gains.ki=+document.getElementById('piKi').value;

  controllers.pid.gains.kp=+document.getElementById('pidKp').value;
  controllers.pid.gains.ki=+document.getElementById('pidKi').value;
  controllers.pid.gains.kd=+document.getElementById('pidKd').value;
}

function syncValues(){
  const ids=['target','wn','zeta','umax','pKp','piKp','piKi','pidKp','pidKi','pidKd'];
  ids.forEach(id=>{
    document.getElementById(id+'Val').textContent=(+document.getElementById(id).value).toFixed(2);
  });
  document.getElementById('speedVal').textContent='×'+(+document.getElementById('speed').value).toFixed(2);
}

function resetController(c){
  c.y=0;
  c.v=0;
  c.integral=0;
  c.prevError=null;
  c.u=0;
  c.hist=[{t:0,y:0}];
}

function resetSimulation(start=true){
  Object.values(controllers).forEach(resetController);
  simTime=0;
  lastFrame=null;
  running=start;
  document.getElementById('playBtn').textContent=running?'Tạm dừng':'Tiếp tục';
  updateVisuals();
}

function stepController(c,dt,p){
  const e=p.target-c.y;
  const de=(c.prevError===null)?0:(e-c.prevError)/dt;

  c.integral += e*dt;

  const rawU =
    c.gains.kp*e +
    c.gains.ki*c.integral +
    c.gains.kd*de;

  c.u=clamp(rawU,-p.umax,p.umax);

  // Plant:
  // y'' + 2*zeta*wn*y' + wn^2*y = wn^2*u
  const a =
    p.wn*p.wn*(c.u-c.y)
    -2*p.zeta*p.wn*c.v;

  c.v += a*dt;
  c.y += c.v*dt;

  c.prevError=e;
}

function mapLaneY(y){
  const t=(clamp(y,CONFIG.laneMin,CONFIG.laneMax)-CONFIG.laneMin)/
          (CONFIG.laneMax-CONFIG.laneMin);
  return CONFIG.laneBottom-(CONFIG.laneBottom-CONFIG.laneTop)*t;
}

function mapGraphY(y){
  const t=(clamp(y,CONFIG.graphMin,CONFIG.graphMax)-CONFIG.graphMin)/
          (CONFIG.graphMax-CONFIG.graphMin);
  return CONFIG.graphY+CONFIG.graphH-CONFIG.graphH*t;
}

function mapGraphX(t){
  return CONFIG.graphX+(t/CONFIG.duration)*CONFIG.graphW;
}

function historyPath(hist){
  if(hist.length<2) return '';
  let d='';
  for(let i=0;i<hist.length;i++){
    const x=mapGraphX(hist[i].t);
    const y=mapGraphY(hist[i].y);
    d+=(i===0?'M':'L')+x.toFixed(2)+' '+y.toFixed(2)+' ';
  }
  return d;
}

function maxY(hist){
  let m=-Infinity;
  for(const p of hist) if(p.y>m)m=p.y;
  return Number.isFinite(m)?m:0;
}

function updateVisuals(){
  const p=getPlant();

  const targetLaneY=mapLaneY(p.target);
  const laneTarget=document.getElementById('laneTarget');
  laneTarget.setAttribute('y1',targetLaneY);
  laneTarget.setAttribute('y2',targetLaneY);

  const laneTargetText=document.getElementById('laneTargetText');
  laneTargetText.setAttribute('y',targetLaneY-8);

  const graphTargetY=mapGraphY(p.target);
  const graphTarget=document.getElementById('graphTarget');
  graphTarget.setAttribute('y1',graphTargetY);
  graphTarget.setAttribute('y2',graphTargetY);

  const graphTargetLabel=document.getElementById('graphTargetLabel');
  graphTargetLabel.setAttribute('y',graphTargetY+4);
  graphTargetLabel.textContent='r='+fmt(p.target,2);

  const ids={
    p:{dot:'pDot',halo:'pHalo',path:'pPath',gdot:'pGraphDot',y:'pY',e:'pE',u:'pU'},
    pi:{dot:'piDot',halo:'piHalo',path:'piPath',gdot:'piGraphDot',y:'piY',e:'piE',u:'piU'},
    pid:{dot:'pidDot',halo:'pidHalo',path:'pidPath',gdot:'pidGraphDot',y:'pidY',e:'pidE',u:'pidU'}
  };

  for(const key of ['p','pi','pid']){
    const c=controllers[key];
    const yy=mapLaneY(c.y);

    document.getElementById(ids[key].dot).setAttribute('cy',yy);
    document.getElementById(ids[key].halo).setAttribute('cy',yy);

    document.getElementById(ids[key].path).setAttribute('d',historyPath(c.hist));

    document.getElementById(ids[key].gdot).setAttribute('cx',mapGraphX(simTime));
    document.getElementById(ids[key].gdot).setAttribute('cy',mapGraphY(c.y));

    document.getElementById(ids[key].y).textContent='y = '+(c.y>=0?'+':'')+fmt(c.y);
    document.getElementById(ids[key].e).textContent='|e| = '+fmt(Math.abs(p.target-c.y));
    document.getElementById(ids[key].u).textContent=fmt(c.u);
  }

  document.getElementById('timeText').textContent='t = '+fmt(simTime,2)+' s';

  const pErr=Math.abs(p.target-controllers.p.y);
  const piOver=maxY(controllers.pi.hist)-p.target;
  const pidOver=maxY(controllers.pid.hist)-p.target;

  let status=TEXT.idle;
  if(simTime>3 && piOver>0.08) status=TEXT.piOvershoot;
  if(simTime>4 && pidOver<piOver*0.75) status=TEXT.pidDamping;
  if(simTime>5 && pErr>0.12) status=TEXT.pOffset;

  document.getElementById('statusText').textContent=status;
}

function frame(ts){
  if(lastFrame===null) lastFrame=ts;

  const dtWall=Math.min((ts-lastFrame)/1000,0.05);
  lastFrame=ts;

  if(running && simTime<CONFIG.duration){
    const plant=getPlant();
    syncGains();

    let advance=dtWall*plant.speed;

    while(advance>0 && simTime<CONFIG.duration){
      const dt=Math.min(CONFIG.fixedDt,advance,CONFIG.duration-simTime);

      stepController(controllers.p,dt,plant);
      stepController(controllers.pi,dt,plant);
      stepController(controllers.pid,dt,plant);

      simTime+=dt;
      advance-=dt;

      const lastT=controllers.p.hist[controllers.p.hist.length-1].t;
      if(simTime-lastT>=0.012 || simTime>=CONFIG.duration){
        controllers.p.hist.push({t:simTime,y:controllers.p.y});
        controllers.pi.hist.push({t:simTime,y:controllers.pi.y});
        controllers.pid.hist.push({t:simTime,y:controllers.pid.y});
      }
    }

    if(simTime>=CONFIG.duration){
      running=false;
      document.getElementById('playBtn').textContent='Chạy lại';
    }

    updateVisuals();
  }

  requestAnimationFrame(frame);
}

/* =========================================================
   Export SVG / PNG
   ========================================================= */
function serializeSVG(){
  const svg=document.getElementById('sim').cloneNode(true);
  svg.setAttribute('xmlns','http://www.w3.org/2000/svg');
  svg.setAttribute('width','900');
  svg.setAttribute('height','1320');
  return new XMLSerializer().serializeToString(svg);
}

function exportSVG(){
  const blob=new Blob([serializeSVG()],{type:'image/svg+xml;charset=utf-8'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');
  a.href=url;
  a.download='pid-controller-race.svg';
  a.click();
  setTimeout(()=>URL.revokeObjectURL(url),1000);
}

function exportPNG(){
  const blob=new Blob([serializeSVG()],{type:'image/svg+xml;charset=utf-8'});
  const url=URL.createObjectURL(blob);
  const img=new Image();

  img.onload=()=>{
    const scale=2;
    const canvas=document.createElement('canvas');
    canvas.width=900*scale;
    canvas.height=1320*scale;

    const ctx=canvas.getContext('2d');
    ctx.scale(scale,scale);
    ctx.fillStyle='#05070d';
    ctx.fillRect(0,0,900,1320);
    ctx.drawImage(img,0,0,900,1320);

    URL.revokeObjectURL(url);

    canvas.toBlob(file=>{
      const a=document.createElement('a');
      a.href=URL.createObjectURL(file);
      a.download='pid-controller-race.png';
      a.click();
      setTimeout(()=>URL.revokeObjectURL(a.href),1000);
    },'image/png');
  };

  img.src=url;
}

